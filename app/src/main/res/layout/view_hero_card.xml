<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="48dp"
    android:layout_marginTop="28dp"
    android:layout_marginEnd="48dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_hero_card"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp">

    <!-- Linke Spalte: Zuletzt geöffnete App (Schnellstart) -->
    <LinearLayout
        android:id="@+id/heroLeftColumn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/heroRecentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/last_app_label"
            android:textAllCaps="true"
            android:textColor="@color/tv_accent_light"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <!-- Schnellstart-Button für die letzte App (D-Pad fokussierbar) -->
        <LinearLayout
            android:id="@+id/heroRecentAppButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hero_recent_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/heroRecentAppIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/last_app_label"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_default" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/heroRecentAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:maxWidth="280dp"
                    android:text="@string/no_recent_app"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/heroRecentAppSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Klicke zum Fortsetzen"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Mittlerer Trenner (subtil) -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/tv_divider" />

    <!-- Rechte Spalte: Uhrzeit, Datum und Live-Wetteranzeige -->
    <LinearLayout
        android:id="@+id/heroRightColumn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <!-- Wetterbereich (Icon, Temperatur & Status) -->
        <LinearLayout
            android:id="@+id/heroWeatherContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="36dp"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/heroWeatherIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Wetter-Symbol"
                    android:src="@drawable/ic_weather_placeholder" />

                <TextView
                    android:id="@+id/heroWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="--°C"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroWeatherDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/weather_loading"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Uhrzeit und Datum -->
        <LinearLayout
            android:id="@+id/heroClockContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/heroTextClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:format24Hour="HH:mm"
                android:format12Hour="hh:mm a"
                android:textColor="@color/tv_text_primary"
                android:textSize="44sp" />

            <TextClock
                android:id="@+id/heroTextDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format24Hour="EEEE, d. MMMM"
                android:format12Hour="EEEE, d. MMMM"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Einstellungs-Icon-Button (D-Pad fokussierbar) -->
        <FrameLayout
            android:id="@+id/heroSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_hero_recent_btn"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings_gear" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
